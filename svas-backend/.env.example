SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Opcionales
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
FEATURE_CLASIFICADOR_LLM=false
ANTHROPIC_API_KEY=
# Reconocimiento de vehiculo por foto, tarjeta y chatbot. Vacia = simulados.
# Con claves nuevas de AI Studio, gemini-2.5-flash responde 404: en local usa gemini-3.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# DeepSeek (de pago, prepagado): respaldo del chatbot si Gemini falla y lector principal de la tarjeta.
# Vacia = sin respaldo en el chat y la tarjeta solo con Gemini.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MODEL_VISION=deepseek-flash
# Correo de la poliza (PDF adjunto) con Resend. Vacia = correo simulado (solo registra).
# Sin dominio verificado en Resend solo sirve onboarding@resend.dev, que entrega unicamente al correo de la cuenta dueña de la clave.
RESEND_API_KEY=
CORREO_REMITENTE=SeguroSimple <onboarding@resend.dev>

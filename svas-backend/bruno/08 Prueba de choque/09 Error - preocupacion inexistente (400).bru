meta {
  name: 09 Error - preocupacion inexistente (400)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/cotizaciones/{{cotChoqueId}}/prueba-choque
  body: json
  auth: none
}

headers {
  X-Cotizacion-Token: {{tokenChoque}}
}

body:json {
  {
    "perfil": { "estacionaCochera": false, "kmMesAlto": false, "usoNocturno": false,
                "preocupaciones": ["TERREMOTO"] }
  }
}

tests {
  test("responde 400", () => expect(res.status).to.equal(400));
  test("dice cuál", () => expect(res.body.message).to.contain("TERREMOTO"));
}

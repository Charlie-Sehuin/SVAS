meta {
  name: 09 Error - pago sin Idempotency-Key (400)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/compras/{{ordenCompraId}}/pago
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clienteToken}}
}

body:json {
  { "modo": "UNICO" }
}

tests {
  test("responde 400", () => expect(res.status).to.equal(400));
  test("pide la clave", () => expect(res.body.message).to.include("Idempotency-Key"));
}

meta {
  name: 02 Vincular cotizacion al cliente
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/cotizaciones/{{cotCompraId}}/cliente
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clienteToken}}
}

headers {
  X-Cotizacion-Token: {{tokenCompra}}
}

body:json {
  {}
}

script:pre-request {
  if (!bru.getVar("clienteToken")) {
    await bru.runRequest("07 Asesoria y retencion/04 Login cliente");
  }
}

tests {
  test("responde 200", () => expect(res.status).to.equal(200));
}

docs {
  La compra exige cuenta: la cotización anónima pasa al cliente de prueba.
}

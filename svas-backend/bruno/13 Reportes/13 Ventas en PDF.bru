meta {
  name: 13 Ventas en PDF
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/admin/reportes/ventas?formato=pdf&agrupar=plan&desde=2026-01-01&hasta=2026-12-31
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("accessToken")) {
    await bru.runRequest("01 Auth/Login admin");
  }
}

tests {
  test("responde 200", () => expect(res.status).to.equal(200));
  test("es un PDF", () => expect(res.headers["content-type"]).to.include("application/pdf"));
  test("nombre con el periodo", () =>
    expect(res.headers["content-disposition"]).to.include('filename="ventas-2026-01-01-a-2026-12-31.pdf"'));
}

docs {
  El mismo reporte de 02 exportado a PDF (RF-30): totales y detalle por grupo.
}

meta {
  name: 08 Error - periodo de mas de un anio (400)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/admin/reportes/descuentos?desde=2024-01-01&hasta=2026-01-01
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("accessToken")) {
    await bru.runRequest("01 Auth/Login admin");
  }
}

tests {
  test("responde 400", () => expect(res.status).to.equal(400));
  test("explica el error", () => expect(res.body.message).to.include("un año"));
}

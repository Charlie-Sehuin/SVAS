meta {
  name: 07 Error - periodo al reves (400)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/admin/reportes/retencion?desde=2026-05-01&hasta=2026-04-01
  body: none
  auth: inherit
}

script:pre-request {
  if (!bru.getVar("accessToken")) {
    await bru.runRequest("01 Auth/Login admin");
  }
}

tests {
  test("responde 400", () => expect(res.status).to.equal(400));
  test("explica el error", () => expect(res.body.message).to.include("posterior"));
}

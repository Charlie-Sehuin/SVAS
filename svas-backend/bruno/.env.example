# Copia este archivo como .env (misma carpeta). .env NO se sube a git.
# Valores: los mismos SUPABASE_URL y SUPABASE_ANON_KEY de svas-backend/.env
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Tu usuario ADMINISTRADOR (el que creaste con npm run crear-admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 07 Asesoria y retencion. Emails de prueba (inventados) y una contraseña tuya
# para el cliente. ASESOR_PASSWORD se llena con la contrasenaTemporal que
# devuelve "01 Crear asesor". NUNCA pongas valores en este archivo.
ASESOR_EMAIL=
ASESOR_PASSWORD=
CLIENTE_EMAIL=
CLIENTE_PASSWORD=

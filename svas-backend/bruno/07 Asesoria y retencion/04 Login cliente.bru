meta {
  name: 04 Login cliente
  type: http
  seq: 4
}

post {
  url: {{supabaseUrl}}/auth/v1/token?grant_type=password
  body: json
  auth: none
}

headers {
  apikey: {{process.env.SUPABASE_ANON_KEY}}
}

body:json {
  {
    "email": "{{process.env.CLIENTE_EMAIL}}",
    "password": "{{process.env.CLIENTE_PASSWORD}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("clienteToken", res.body.access_token);
  }
}

tests {
  test("login correcto", () => expect(res.status).to.equal(200));
}

docs {
  Guarda `clienteToken`.
}

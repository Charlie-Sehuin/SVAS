meta {
  name: 06 Vincular cotizacion al cliente
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/cotizaciones/{{cotAsesoriaId}}/cliente
  body: json
  auth: bearer
}

auth:bearer {
  token: {{clienteToken}}
}

headers {
  X-Cotizacion-Token: {{tokenAsesoria}}
}

body:json {
  {}
}

tests {
  test("responde 200", () => expect(res.status).to.equal(200));
}

docs {
  La cotización anónima pasa a la cuenta del cliente (necesita su X-Cotizacion-Token).
}

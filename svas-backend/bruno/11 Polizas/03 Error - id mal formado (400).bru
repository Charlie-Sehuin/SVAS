meta {
  name: 03 Error - id mal formado (400)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/polizas/abc/pdf
  body: none
  auth: bearer
}

auth:bearer {
  token: {{clienteToken}}
}

script:pre-request {
  if (!bru.getVar("clienteToken")) {
    await bru.runRequest("07 Asesoria y retencion/04 Login cliente");
  }
}

tests {
  test("responde 400", () => expect(res.status).to.equal(400));
  test("mensaje", () => expect(res.body.message).to.equal("La póliza no es válida"));
}
